# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Google OAuth and Drive. Never expose these to the browser.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_DRIVE_ROOT_ID=YOUR_SELECTED_FOLDER_ID
PLT_OWNER_EMAIL=qianpingkang@gmail.com

# Production deployment
GOOGLE_CLOUD_PROJECT_ID=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_REGION=us-west1
GOOGLE_WEBHOOK_VERIFICATION_SECRET=GENERATE_A_RANDOM_32_BYTE_VALUE
TOKEN_ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64_KEY

# Queue and reconciliation
REDIS_URL=rediss://YOUR_MANAGED_REDIS_ENDPOINT
RECONCILIATION_CRON=*/15 * * * *
